# Gaming Platform - Production Environment Configuration
# Copy this file to .env.production and fill in actual values

# Application
APP_NAME="Gaming Platform"
APP_ENV=production
DEBUG=False
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Database
DATABASE_URL=postgresql+asyncpg://username:password@postgres:5432/gaming_platform_prod
POSTGRES_DB=gaming_platform_prod
POSTGRES_USER=gaming_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT & Security
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME="Gaming Platform"

# SMS Configuration (for OTP)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# UPI Configuration
UPI_MERCHANT_ID=CHANGE_ME
UPI_MERCHANT_KEY=CHANGE_ME

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# KYC Configuration
KYC_AADHAAR_VERIFICATION_ENABLED=True
KYC_PAN_VERIFICATION_ENABLED=True
KYC_AUTO_APPROVE_THRESHOLD=0.95

# Wallet Configuration
MIN_DEPOSIT_AMOUNT=100
MAX_DEPOSIT_AMOUNT=100000
MIN_WITHDRAWAL_AMOUNT=200
MAX_WITHDRAWAL_AMOUNT=50000
WITHDRAWAL_FEE_PERCENTAGE=2.0
PLATFORM_FEE_PERCENTAGE=10.0

# Game Configuration
MAX_GAME_SESSION_DURATION_MINUTES=60
MIN_ENTRY_FEE=50
MAX_ENTRY_FEE=10000
DEFAULT_MAX_PLAYERS=4

# Rewards Configuration
REFERRAL_BONUS_AMOUNT=100
REFERRAL_DEPOSIT_BONUS_PERCENTAGE=10
MIN_DEPOSIT_FOR_REFERRAL_BONUS=500
DAILY_BONUS_ENABLED=True
LEADERBOARD_UPDATE_INTERVAL_MINUTES=15

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Monitoring & Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=True
PROMETHEUS_PORT=9090

# Celery (Background Tasks)
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REDIS_PASSWORD@redis:6379/2

# Feature Flags
FEATURE_TOURNAMENTS=True
FEATURE_LIVE_CHAT=True
FEATURE_SOCIAL_LOGIN=False

# External Services
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
