# Gaming Platform - Staging Environment Configuration
# Copy this file to .env.staging and fill in actual values

# Application
APP_NAME="Gaming Platform - Staging"
APP_ENV=staging
DEBUG=True
LOG_LEVEL=DEBUG

# API Configuration
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["https://staging.yourdomain.com","http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://username:password@postgres:5432/gaming_platform_staging
POSTGRES_DB=gaming_platform_staging
POSTGRES_USER=gaming_user_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD

# Redis
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_STAGING

# JWT & Security
SECRET_KEY=CHANGE_ME_STAGING_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email Configuration (use test accounts)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=CHANGE_ME_MAILTRAP_PASSWORD
SMTP_FROM_EMAIL=staging@yourdomain.com
SMTP_FROM_NAME="Gaming Platform Staging"

# SMS Configuration (use test mode)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME_TEST_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TEST_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway (test mode)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=CHANGE_ME_TEST_KEY
RAZORPAY_KEY_SECRET=CHANGE_ME_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_TEST_WEBHOOK

# UPI Configuration (test)
UPI_MERCHANT_ID=CHANGE_ME_TEST
UPI_MERCHANT_KEY=CHANGE_ME_TEST

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# KYC Configuration (relaxed for staging)
KYC_AADHAAR_VERIFICATION_ENABLED=False
KYC_PAN_VERIFICATION_ENABLED=False
KYC_AUTO_APPROVE_THRESHOLD=0.50

# Wallet Configuration
MIN_DEPOSIT_AMOUNT=10
MAX_DEPOSIT_AMOUNT=10000
MIN_WITHDRAWAL_AMOUNT=20
MAX_WITHDRAWAL_AMOUNT=5000
WITHDRAWAL_FEE_PERCENTAGE=2.0
PLATFORM_FEE_PERCENTAGE=10.0

# Game Configuration
MAX_GAME_SESSION_DURATION_MINUTES=120
MIN_ENTRY_FEE=10
MAX_ENTRY_FEE=1000
DEFAULT_MAX_PLAYERS=4

# Rewards Configuration
REFERRAL_BONUS_AMOUNT=50
REFERRAL_DEPOSIT_BONUS_PERCENTAGE=10
MIN_DEPOSIT_FOR_REFERRAL_BONUS=100
DAILY_BONUS_ENABLED=True
LEADERBOARD_UPDATE_INTERVAL_MINUTES=5

# Rate Limiting (relaxed)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=120

# Monitoring & Logging
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=True
PROMETHEUS_PORT=9090

# Celery
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REDIS_PASSWORD@redis:6379/2

# Feature Flags
FEATURE_TOURNAMENTS=True
FEATURE_LIVE_CHAT=True
FEATURE_SOCIAL_LOGIN=True

# External Services
CLOUDINARY_CLOUD_NAME=CHANGE_ME_TEST
CLOUDINARY_API_KEY=CHANGE_ME_TEST
CLOUDINARY_API_SECRET=CHANGE_ME_TEST

# Admin
ADMIN_EMAIL=admin@staging.yourdomain.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STAGING_PASSWORD

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_STAGING
